{
	"name": "turtle-theme",
	"displayName": "Turtle Theme Collection",
	"description": "A collection of themes by a turtle, for turtles",
	"version": "5.0.7",
	"publisher": "CiberTurtle",
	"private": true,
	"license": "MIT",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/rylydou/turtle-theme"
	},
	"bugs": "https://github.com/rylydou/turtle-theme/issues",
	"homepage": "https://github.com/rylydou/turtle-theme#readme",
	"keywords": [
		"theme",
		"color theme",
		"dark theme",
		"light theme",
		"monokai",
		"zughy",
		"pixel art"
	],
	"categories": [
		"Themes"
	],
	"galleryBanner": {
		"color": "#cd6093",
		"theme": "dark"
	},
	"pricing": "Free",
	"engines": {
		"vscode": "^1.0.0"
	},
	"contributes": {
		"themes": [
			{
				"label": "Turtle Theme - Zughy Dark",
				"uiTheme": "vs-dark",
				"path": "./dist/zughy-dark.json"
			},
			{
				"label": "Turtle Theme - Zughy Light",
				"uiTheme": "vs",
				"path": "./dist/zughy-light.json"
			},
			{
				"label": "Turtle Theme - Monokai Dark",
				"uiTheme": "vs-dark",
				"path": "./dist/monokai-dark.json"
			},
			{
				"label": "Turtle Theme - Monokai Light",
				"uiTheme": "vs",
				"path": "./dist/monokai-light.json"
			}
		]
	},
	"files": [
		"dist",
		"images/icon.png",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"build": "bun src/build.ts",
		"check": "bun src/build.ts --check && tsc",
		"images": "bun src/images.ts",
		"package": "bun src/release.ts package",
		"dogfood": "bun src/release.ts dogfood",
		"publish": "bun src/release.ts publish",
		"vscode:prepublish": "bun run build"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@types/bun": "^1.4.4",
		"@vscode/vsce": "^4.1.0",
		"dejavu-fonts-ttf": "2.37.3",
		"ovsx": "^1.3.0",
		"typescript": "^7.0.2"
	}
}
